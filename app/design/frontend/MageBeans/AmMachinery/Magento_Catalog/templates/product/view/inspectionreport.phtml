<?php 
// Get product and attributes
global $_product; 
$_product = $block->getProduct();
$attributeSetId = $_product->getAttributeSetId();
$groupId = $block->getAttributeGroupId($attributeSetId);
$attributesGroups = $block->getAttributeGroups($attributeSetId);
$productAttributes = $_product->getAttributes();

$countAttributes = $block->getCountAttributes($_product, $attributesGroups, $productAttributes);
$productCategoryIds = $_product->getCategoryIds();

// Define category arrays
$checkCategory = [108, 99, 117, 119, 123];
$checkCategoryAccessory = [298];

// Check category matches
$match = !empty(array_intersect($productCategoryIds, $checkCategory));
$accCat = !empty(array_intersect($productCategoryIds, $checkCategoryAccessory));
?>

<?php if ($accCat): ?>
    <script>
        require(['jquery'], function ($) {
            $(document).ready(function () {
                $('#inspection-report').hide();
                $('.inspection-attr').css('display', 'none');
            });
        });
    </script>
<?php endif; ?>

<div class="inspection-report-attr" id="inspection-report">
    <?php if ($match): ?>
        <h3 class="col label" scope="row">
            <span class="harvest_logo">
                <img src="<?php echo $this->getViewFileUrl('images/harvester-guard-logo.png'); ?>" alt="Harvester Guard">
            </span>
            <span class="harvest_logo_am">AM:</span>
            <?php echo __('Harvester Guard') ?>&reg; <?php echo __('Inspection Report') ?>
        </h3>

        <div class="inspection-report-row">
            <div class="inspection-star">
                <?php echo $block->getLayout()
                    ->createBlock('Magento\Cms\Block\Block')
                    ->setBlockId('inspection_report_right_block')
                    ->toHtml(); ?>
            </div>
        </div>
    <?php else: ?>
        <style type="text/css">
            body.catalog-product-view .product-details-custom {
                border-bottom: none;
            }
            .catalog-product-view .inspection-report-attr {
                padding: 0;
            }
        </style>
    <?php endif; ?>

    <div class="row inspection-content">
        <?php
        $arrayFirstGroup = ['Levels', 'Functional test'];
        $arraySecondGroup = ['Feedrolls', 'Knive drum', 'Corn cave', 'Kernal processor', 'Blower', 'Transition housing', 'Spout', 'Engine','Header'];
        $arrayThirdGroup = ['Machine body', 'Main drive', 'Operational test', 'Operators station'];
        $arrayGreenTitle = ['Levels', 'Options', 'Recommended repairs'];
        
        $second = true;
        $third = true;

        foreach ($attributesGroups as $attributesGroup) {
            $groupName = $attributesGroup->getAttributeGroupName();
            $attributes = $block->getGroupAttributes($_product, $attributesGroup->getAttributeGroupId(), $productAttributes);

            if ($attributes && in_array($groupName, array_merge($arrayFirstGroup, $arraySecondGroup, $arrayThirdGroup))): ?>
                <div class="inspection-report-content col-md-4">
                    <label class="inspectionreport-title <?php //echo in_array($groupName, $arrayGreenTitle) ? 'green-title' : ''; ?>" style="color: #a3c967 !important;">
                       <b> <?php echo __($groupName); ?></b>
                    </label>

                    <ul>
                        <?php foreach ($attributes as $attribute): ?>
                            <li>
                                <?php if ($attribute->getFrontendLabel() !== 'Recommended repairs'): ?>
                                    <label class="label">
                                        <?php echo $block->escapeHtml(__($attribute->getStoreLabel())); ?>
                                    </label>
                                <?php endif; ?>

                                <?php $value = $attribute->getFrontend()->getValue($_product); ?>
                                <?php if (in_array($value, ['1', '2', '3', '4', '5'])): ?>
                                    <span class="col data feature star-<?php echo $value; ?> star">
                                        <?php echo $value; ?>
                                    </span>
                                <?php else: ?>
                                    <span class="col data feature">
                                        <?php echo $value; ?>
                                    </span>
                                <?php endif; ?>
                            </li>
                        <?php endforeach; ?>
                    </ul>
                </div>
            <?php endif; ?>
        <?php } ?>
    </div>
</div>

<?php echo $this->getLayout()
    ->createBlock('Magento\Catalog\Block\Product\View')
    ->setTemplate('Magento_Catalog::product/view/tabs/downloadmobile.phtml')
    ->toHtml(); ?>

<script type="text/javascript">
    require(['jquery', 'lightbox'], function ($, lightbox) {});
</script>
